<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.gameinventory.controllers.MainController"
      spacing="12" style="-fx-padding: 24;">

    <Label text="Учёт игрового инвентаря"
           style="-fx-font-size: 22px; -fx-font-weight: bold;"/>

    <GridPane hgap="8" vgap="8">
        <Label text="Email:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <TextField fx:id="emailField" prefWidth="300"
                   GridPane.rowIndex="0" GridPane.columnIndex="1"/>

        <Label text="Пароль:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <PasswordField fx:id="passwordField"
                       GridPane.rowIndex="1" GridPane.columnIndex="1"/>

        <Button text="Войти" onAction="#onLogin"
                GridPane.rowIndex="2" GridPane.columnIndex="1"/>
    </GridPane>

    <Label fx:id="statusLabel" text=""
           style="-fx-text-fill: #b00020;"/>

    <Label fx:id="charactersHeader" text="Ваши персонажи:"
           style="-fx-font-size: 16px;" visible="false"/>
    <VBox fx:id="charactersContainer" spacing="6"/>
</VBox>